<Project Sdk="Microsoft.NET.Sdk">

  <!-- Remote control for an unchanged Smithbox: loaded into Smithbox.Vulkan with DOTNET_STARTUP_HOOKS -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configurations>Release-win;Release-linux</Configurations>
    <!-- The Smithbox sources: a checkout in smithbox/ (see README), or -p:SmithboxSrc=<path to Smithbox/src> -->
    <SmithboxSrc Condition="'$(SmithboxSrc)' == ''">$(MSBuildThisFileDirectory)smithbox/src</SmithboxSrc>
    <DefaultItemExcludes>$(DefaultItemExcludes);smithbox/**;out/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SmithboxSrc)/Smithbox.Program/Smithbox.Program.csproj" Private="false" />
  </ItemGroup>

</Project>
